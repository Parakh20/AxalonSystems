# Public Mapbox token used for the Anomaly Map basemap (Satellite Streets v12).
# Get one free at https://account.mapbox.com/access-tokens/.
# When unset, the map falls back to Esri World Imagery (no key required).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public Google Maps browser key used for the Park Map orthomosaic view.
# Restrict the key to the allowed website origins in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Base URL of the Axalon FastAPI backend.
# Used by the /platform page for uploads, status polling, map data, and ortho tiles.
NEXT_PUBLIC_AXALON_API_URL=http://localhost:8000
