[Unit]
Description=Axalon Platform API (FastAPI + YOLO11m)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/AxalonSystems
Environment=PYTHONSAFEPATH=1
EnvironmentFile=/home/ubuntu/AxalonSystems/.env
ExecStart=/home/ubuntu/AxalonSystems/.venv/bin/python -m uvicorn axalon.api.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
