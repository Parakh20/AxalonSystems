# Axalon Drone Relay — environment secrets
# Copy to /home/ubuntu/AxalonSystems/.env.relay on the Oracle VM.
# NEVER commit this file with real values.

# Per-drone tokens: comma-separated id:token pairs.
# Generate a token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DRONE_TOKENS=drone-01:REPLACE_WITH_DRONE_TOKEN

# Operator token: what the browser sends to connect.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_TOKEN=REPLACE_WITH_OPS_TOKEN

# coturn TURN server (same VM). Must match turnserver.conf static-auth-secret.
TURN_HOST=relay.axalonsystems.com
TURN_SECRET=REPLACE_WITH_TURN_SECRET

# Optional. Browser origins allowed to call GET /turn-credentials (comma-separated).
# Default: https://axalonsystems.com,https://www.axalonsystems.com
# RELAY_CORS_ORIGINS=https://axalonsystems.com,https://www.axalonsystems.com,http://localhost:3000

# Optional. Seconds between {"type":"ping"} frames sent to operator sockets so
# proxies with ~60 s idle timeouts keep them open. Default 25; <= 0 disables.
# RELAY_PING_INTERVAL_S=25
