# Axalon Platform — backend environment template
# Copy to .env on the server:  cp .env.example .env  (then fill in real values)
# Loaded by the FastAPI backend (axalon.api.app).

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (default): leave unset → sqlite:///axalon.db
# Production (Supabase Postgres): use the URI from
#   Supabase → Project Settings → Database → Connection string (URI)
#   and prefix the driver with postgresql+psycopg2://
# AXALON_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOURREF.supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. If unset, the API is wide open to anyone.
# Teammates enter this shared key once in the platform login gate.
AXALON_API_KEY=change-me-to-a-long-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. axalonsystems.com is already a default;
# set this only if your frontend lives on a different domain.
# AXALON_CORS_ORIGINS=https://axalonsystems.com,https://www.axalonsystems.com

# ── Inference ─────────────────────────────────────────────────────────────────
# Set true ONLY on the Jetson after exporting best.engine (TensorRT).
# On a CPU cloud VM (Oracle), leave this false — it uses best.pt.
AXALON_USE_ENGINE=false

# ── Storage / housekeeping (optional) ─────────────────────────────────────────
# AXALON_OUTPUT_DIR=output
# AXALON_RESULTS_TTL_HOURS=24
